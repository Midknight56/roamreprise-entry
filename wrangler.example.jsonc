{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roamreprise",
  // The hackathon account. Deploy with `python dev/cf.py deploy`. For your own account copy wrangler.example.jsonc.
  "account_id": "<your account id>",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8811, "ip": "127.0.0.1" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/webhooks/*", "/healthz"] },
  "ai": { "binding": "AI" },
  // The shared neuron ledger of every hackathon app on the account. Remote even in `wrangler dev`, so local runs count.
  "d1_databases": [{ "binding": "LEDGER", "database_name": "hackathon-ledger", "database_id": "<your D1 database id with an ai_calls table, see dev/ledger.sql>", "remote": true }],
  "durable_objects": {
    "bindings": [
      { "name": "TRIP", "class_name": "TripDO" },
      { "name": "GATE", "class_name": "GateDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TripDO", "GateDO"] }],
  "vars": { "BUILD_TAG": "2026-11-08", "PAYPAL_BASE": "https://api-m.sandbox.paypal.com", "LIVE_AI": "1", "DEV_ROUTES": "0" },
  "observability": { "enabled": true }
}
